# =========================
# CitizenAlert Agent (:8004)
# =========================

# Kafka
KAFKA_BROKER=localhost:9092
EVENT_VERSION=v1

# --- Twilio SMS (optional - logs mock if missing) ---
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
CITIZEN_ALERT_PHONE_NUMBER=+91XXXXXXXXXX

# --- SMTP Email (optional - logs mock if missing) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME@gmail.com
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=REPLACE_ME@gmail.com
CITIZEN_ALERT_EMAIL=REPLACE_ME@gmail.com

# --- Discord Webhook (optional - logs mock if missing) ---
# Create at: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=REPLACE_ME
