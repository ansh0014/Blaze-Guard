# =========================
# Logistics Agent (:8003)
# =========================

# Kafka
KAFKA_BROKER=localhost:9092
EVENT_VERSION=v1

# PostgreSQL with PostGIS (use DATABASE_URL OR individual fields)
DATABASE_URL=postgres://postgres:REPLACE_ME@localhost:5432/blazeguard?sslmode=disable
# -- OR individual fields --
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=REPLACE_ME
# DB_NAME=blazeguard
# DB_SSLMODE=disable

# Mapbox (for routing between fire stations and fire locations)
# Get from: https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=REPLACE_ME
MAPBOX_BASE_URL=https://api.mapbox.com

# A2A - URLs of other agents this agent talks to
CITIZEN_ALERT_AGENT_URL=http://localhost:8004
