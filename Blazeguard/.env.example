# =========================
# App
# =========================
APP_ENV=development
EVENT_VERSION=v1

# =========================
# Kafka
# =========================
KAFKA_BROKER=localhost:9092
KAFKA_DLQ_TOPIC=events_dlq

# =========================
# API Gateway / Frontend
# =========================
PORT=8080
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_BASE_URL=http://localhost:2000
VITE_ORCHESTRATOR_URL=http://localhost:8090

# =========================
# Orchestrator
# =========================
ORCHESTRATOR_PORT=8090
ORCHESTRATOR_GRPC_PORT=9090
DETECTION_AGENT_URL=http://localhost:8001
PREDICTION_AGENT_URL=http://localhost:8002
LOGISTICS_AGENT_URL=http://localhost:8003
CITIZEN_ALERT_AGENT_URL=http://localhost:8004
SELF_AGENT_URL=http://localhost:8005

# =========================
# Logistics DB (PostGIS)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
DB_NAME=blazeguard
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:REPLACE_ME@localhost:5432/blazeguard?sslmode=disable

# Oracle AI DB 26ai Memory
ORACLE_AI_DB_HOST=localhost
ORACLE_AI_DB_PORT=1521
ORACLE_AI_DB_SERVICE=FREEPDB1
ORACLE_AI_DB_USER=blazeguard
ORACLE_AI_DB_PASSWORD=REPLACE_ME
ORACLE_AI_DB_DSN=oracle://blazeguard:REPLACE_ME@localhost:1521/FREEPDB1

# External APIs
MAPBOX_API_KEY=REPLACE_ME
WEATHER_API_KEY=REPLACE_ME
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
NASA_FIRMS_API_KEY=REPLACE_ME

# Real-time Notification Services
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=REPLACE_ME
CITIZEN_ALERT_PHONE_NUMBER=REPLACE_ME

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=REPLACE_ME
CITIZEN_ALERT_EMAIL=REPLACE_ME

DISCORD_WEBHOOK_URL=REPLACE_ME

# Reliability
REQUEST_TIMEOUT_SECONDS=10
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300