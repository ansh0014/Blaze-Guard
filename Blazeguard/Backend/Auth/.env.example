# =========================
# Auth Service (:2000)
# =========================

# Server
PORT=2000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (use DATABASE_URL OR individual fields)
DATABASE_URL=postgres://postgres:REPLACE_ME@localhost:5432/blazeguard?sslmode=disable
# -- OR individual fields --
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=REPLACE_ME
# DB_NAME=blazeguard
# DB_SSLMODE=disable

# Session (cookie-based)
SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
SESSION_NAME=blazeguard_session

# Firebase Admin SDK (service account JSON file path)
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Supabase JWT (if using Supabase Auth in addition to Firebase)
SUPABASE_JWT_SECRET=REPLACE_ME
